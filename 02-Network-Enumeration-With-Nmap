# 8. Packet tracing
sudo nmap --packet-trace <TARGET>

# 9. Source-port manipulation
sudo nmap -sS -p<PORT> --source-port 53 <TARGET>

# 10. Save results
sudo nmap -oA scan <TARGET>
```

